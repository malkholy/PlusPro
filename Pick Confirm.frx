      <Column Name="ItemExtraDescription" DataType="System.String"/>
      <Column Name="SellingConversion" DataType="System.Int32"/>
      <Column Name="Allocated" DataType="System.Decimal"/>
      <Column Name="OrderNumber" DataType="System.Int32"/>
      <Column Name="LoadNumber" DataType="System.Int32"/>
      <Column Name="LoadLineNumber" DataType="System.Int32"/>
      <Column Name="OrderLineNumber" DataType="System.Int32"/>
      <Column Name="ShippedQuantitySelling" DataType="System.Decimal"/>
      <Column Name="ShipQuantityStocking" DataType="System.Decimal"/>
      <Column Name="LineShipDate" DataType="System.DateTime"/>
    </TableDataSource>
    <Total Name="Master Data" Expression="[Table2.ShipQuantityStocking]" Evaluator="MasterData1"/>
    <Total Name="PckgNumber" Expression="[Table2.ShippedQuantitySelling]" Evaluator="MasterData1"/>
  </Dictionary>
