<Report ScriptLanguage="CSharp" ReportInfo.Created="10/28/2015 11:50:00" ReportInfo.Modified="09/18/2023 23:03:58" ReportInfo.CreatorVersion="2021.2.8.0">
  <ScriptText>using System;
using System.Collections;
using System.Collections.Generic;
using System.ComponentModel;
using System.Windows.Forms;
using System.Drawing;
using System.Data;
using FastReport;
using FastReport.Data;
using FastReport.Dialog;
using FastReport.Barcode;
using FastReport.Table;
using FastReport.Utils;

namespace FastReport
{
  public class ReportScript
  {
    public string ParseDate(decimal x)
    {    
      string ReleaseDate= &quot;&quot;;
      if(x==0)
      {          
        ReleaseDate=&quot;&quot;;
      }
      else
      {  
        ReleaseDate=  x.ToString();
        DateTime parsedDateTime = DateTime.ParseExact(ReleaseDate, &quot;yyyyMMdd&quot;, System.Globalization.CultureInfo.InvariantCulture);
        ReleaseDate= parsedDateTime.ToString(&quot;yyyy/MM/dd&quot;);
      }
      return ReleaseDate;
    }
    
    public string ParseItemDescription(string item, string description , decimal flag)
    {
        if((item == &quot;SDA303000P&quot;) || ( item == &quot;SDA303014P&quot; &amp;&amp; flag == 1 ))
          return description + &quot; (الصعيد) &quot;;
        return description ;        
    }
    public bool GetDevission(decimal val1,decimal val2)
    {
      if (val2==0)
      {    
        return false;
      }
      else
      {
	         return (val1/val2)!=1;
      }
    }
  }
}
</ScriptText>
