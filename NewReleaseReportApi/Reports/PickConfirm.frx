<?xml version="1.0" encoding="utf-8"?>
<Report ScriptLanguage="CSharp" ReportInfo.Created="10/28/2015 15:11:50" ReportInfo.Modified="01/02/2023 15:15:58" ReportInfo.CreatorVersion="2021.2.8.0">
  <ScriptText>using System;
using System.Collections;
using System.Collections.Generic;
using System.ComponentModel;
using System.Windows.Forms;
using System.Drawing;
using System.Data;
using FastReport;
using FastReport.Data;
using FastReport.Dialog;
using FastReport.Barcode;
using FastReport.Table;
using FastReport.Utils;

namespace FastReport
{
  public class ReportScript
  {
    public string ParseDate(decimal x)
    {    
      string ReleaseDate= &quot;&quot;;
      if(x==0)
      {          
        ReleaseDate=&quot;&quot;;
      }
      else
      {  
        ReleaseDate=  x.ToString();
        DateTime parsedDateTime = DateTime.ParseExact(ReleaseDate, &quot;yyyyMMdd&quot;, System.Globalization.CultureInfo.InvariantCulture);
        ReleaseDate= parsedDateTime.ToString(&quot;yyyy/MM/dd&quot;);
      }
      return ReleaseDate;
    } 
    
    public string ParseItemDescription(string item, string description)
    {
      if(item == &quot;SDA303000P&quot;)
        return description + &quot; (الصعيد) &quot;;
      return description ;        
    }
	
    
    
    public string GetTitle(string orderType)
    {
      return orderType==&quot;3&quot;?&quot;إذن مرتجع&quot;:&quot;إذن تسليم&quot;;
    }
  } 
}
</ScriptText>
