<?xml version="1.0" encoding="utf-8"?>
<Report ScriptLanguage="CSharp" ReportInfo.Created="2026-08-06T22:15:08.422Z" ReportInfo.Modified="2026-08-06T22:15:08.423Z" ReportInfo.CreatorVersion="2024.2.9.0">
  <ScriptText>using System;
using System.Collections;
using System.Collections.Generic;
using System.ComponentModel;
using System.Windows.Forms;
using System.Drawing;
using System.Data;
using FastReport;
using FastReport.Data;
using FastReport.Dialog;
using FastReport.Barcode;
using FastReport.Table;
using FastReport.Utils;

namespace FastReport
{
  public class ReportScript
  {
    public string GetMonthName(int m)
    {
      string[] names = { &quot;&quot;, &quot;January&quot;,&quot;February&quot;,&quot;March&quot;,&quot;April&quot;,&quot;May&quot;,&quot;June&quot;,&quot;July&quot;,&quot;August&quot;,&quot;September&quot;,&quot;October&quot;,&quot;November&quot;,&quot;December&quot; };
      return (m &gt;= 1 &amp;&amp; m &lt;= 12) ? names[m] : m.ToString();
    }

    public string FormatPct(decimal v)
    {
      string sign = v &gt; 0 ? &quot;+&quot; : &quot;&quot;;
      return sign + v.ToString(&quot;N2&quot;) + &quot;%&quot;;
    }

    public decimal SafeDivide(decimal a, decimal b)
    {
      return b == 0 ? 0 : a / b;
    }
  }
}
</ScriptText>
